{
  "rules": {
    "secrets": {
      "$code": {
        ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
        ".write": "auth != null && ((!data.exists() && root.child('rooms/'+$code+'/meta/teacher').val() === auth.uid) || (!newData.exists() && root.child('admins/'+auth.uid).val() === true))",
        "hallKey": {
          ".validate": "newData.isString() && newData.val().length === 4"
        }
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true && ((!data.exists() && newData.child('meta/teacher').val() === auth.uid) || !newData.exists())",
        "hosts": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('secrets/'+$code+'/hallKey').val()"
          }
        },
        "state": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/meta/teacher').val() === auth.uid || (root.child('rooms/'+$code+'/hosts/'+auth.uid).isString() && root.child('rooms/'+$code+'/hosts/'+auth.uid).val() === root.child('secrets/'+$code+'/hallKey').val()))"
        },
        "active": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/meta/teacher').val() === auth.uid || (root.child('rooms/'+$code+'/hosts/'+auth.uid).isString() && root.child('rooms/'+$code+'/hosts/'+auth.uid).val() === root.child('secrets/'+$code+'/hallKey').val()))"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['num', 'nick', 'hero']) && newData.child('num').isNumber() && newData.child('num').val() >= 0 && newData.child('num').val() <= 40 && newData.child('nick').isString() && newData.child('nick').val().length <= 8"
          }
        },
        "help": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (root.child('rooms/'+$code+'/meta/teacher').val() === auth.uid || (root.child('rooms/'+$code+'/hosts/'+auth.uid).isString() && root.child('rooms/'+$code+'/hosts/'+auth.uid).val() === root.child('secrets/'+$code+'/hallKey').val())))"
          }
        },
        "subs": {
          "$mid": {
            "$uid": {
              "$attempt": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/'+$code+'/active/'+$uid).val() === true && ($attempt === '0' || $attempt === '1' || $attempt === '2' || $attempt === '3' || $attempt === '4' || $attempt === '5')",
                ".validate": "newData.isString() && newData.val().length < 20000"
              }
            }
          }
        },
        "heals": {
          "$mid": {
            "$uid": {
              "$k": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/'+$code+'/active/'+$uid).val() === true && ($k === '0' || $k === '1' || $k === '2' || $k === '3' || $k === '4')",
                ".validate": "newData.isString() && newData.val().length <= 128"
              }
            }
          }
        },
        "bossAns": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/'+$code+'/active/'+$uid).val() === true",
            "$set": {
              ".validate": "($set === '1' || $set === '2') && newData.isString() && newData.val().length < 20000"
            }
          }
        },
        "online": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "words": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/'+$code+'/active/'+$uid).val() === true",
            ".validate": "newData.hasChildren(['t', 'n']) && newData.child('t').isString() && newData.child('t').val().length <= 20 && newData.child('n').isNumber() && newData.child('n').val() <= 2"
          }
        },
        "hide": {
          "$uid": {
            ".write": "auth != null && (root.child('rooms/'+$code+'/meta/teacher').val() === auth.uid || (root.child('rooms/'+$code+'/hosts/'+auth.uid).isString() && root.child('rooms/'+$code+'/hosts/'+auth.uid).val() === root.child('secrets/'+$code+'/hallKey').val()))"
          }
        },
        "fun": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/meta/teacher').val() === auth.uid || (root.child('rooms/'+$code+'/hosts/'+auth.uid).isString() && root.child('rooms/'+$code+'/hosts/'+auth.uid).val() === root.child('secrets/'+$code+'/hallKey').val()))"
        },
        "fv": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/meta/teacher').val() === auth.uid || (root.child('rooms/'+$code+'/hosts/'+auth.uid).isString() && root.child('rooms/'+$code+'/hosts/'+auth.uid).val() === root.child('secrets/'+$code+'/hallKey').val()))",
          "$rk": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms/'+$code+'/players/'+$uid).exists() && root.child('rooms/'+$code+'/fun/rk').val() === $rk && root.child('rooms/'+$code+'/fun/phase').val() === 'pick' && now <= root.child('rooms/'+$code+'/fun/to').val() + 1500",
              ".validate": "newData.val() === 'a' || newData.val() === 'b' || newData.val() === 'c'"
            }
          }
        },
        "oxq": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/meta/teacher').val() === auth.uid || (root.child('rooms/'+$code+'/hosts/'+auth.uid).isString() && root.child('rooms/'+$code+'/hosts/'+auth.uid).val() === root.child('secrets/'+$code+'/hallKey').val()))"
        },
        "lvup": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['lv', 'at']) && newData.child('lv').isNumber()"
          }
        },
        "hits": {
          "$uid": {
            "$k": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/'+$code+'/active/'+$uid).val() === true && $k.length <= 40",
              ".validate": "newData.hasChildren(['at', 'ac']) && newData.child('at').val() === now && newData.child('ac').isNumber() && (!newData.child('ok').exists() || newData.child('ok').isBoolean())"
            }
          }
        },
        "batA": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/'+$code+'/active/'+$uid).val() === true && root.child('rooms/'+$code+'/state/bat/at').isNumber() && now <= root.child('rooms/'+$code+'/state/bat/at').val() + 21500",
            ".validate": "newData.val() === 'o' || newData.val() === 'x'"
          }
        },
        "bossTry": {
          "$uid": {
            "$i": {
              "$a": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/'+$code+'/active/'+$uid).val() === true && $i.matches(/^[0-9]$/) && ($a === '0' || $a === '1' || $a === '2' || $a === '3')",
                ".validate": "newData.isString() && newData.val().length < 20000"
              }
            }
          }
        }
      }
    },
    "prepVideo": {
      "$lesson": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "$slot": {
          ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().length < 4500000 && newData.val().beginsWith('data:video/')"
        }
      }
    },
    "prep": {
      "$lesson": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "img": {
          "$slot": {
            ".validate": "newData.isString() && newData.val().length < 2500000 && newData.val().beginsWith('data:image/')"
          }
        },
        "pct": {
          ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 100"
        },
        "think": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        },
        "video": {
          "$slot": {
            ".validate": "newData.isString() && newData.val().length < 300 && (newData.val() === 'file' || newData.val().beginsWith('https://youtu.be/') || newData.val().beginsWith('https://www.youtube.com/') || newData.val().beginsWith('https://youtube.com/') || newData.val().beginsWith('https://m.youtube.com/') || newData.val().beginsWith('https://drive.google.com/'))"
          }
        }
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password' && !root.child('admins').exists()",
        ".validate": "newData.val() === true"
      }
    },
    "rosterMask": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$c": {
        "$n": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        }
      }
    },
    "roster": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$c": {
        "$n": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        }
      }
    },
    "accounts": {
      ".read": "auth != null",
      "$c": {
        "$n": {
          ".write": "auth != null && (root.child('admins/'+auth.uid).val() === true || (newData.child('uid').val() === auth.uid && root.child('roster/'+$c+'/'+$n).exists() && (!data.exists() || data.child('reset').val() === true || data.child('uid').val() === auth.uid)))"
        }
      }
    },
    "unlock": {
      ".read": "auth != null",
      "$c": {
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30"
      }
    },
    "evalOpen": {
      ".read": "auth != null",
      "$c": {
        "$e": {
          ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
          ".validate": "newData.isBoolean() && newData.val() === true && $e.matches(/^eval-[0-9]+$/)"
        }
      }
    },
    "wordLock": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
    },
    "cards": {
      "$c": {
        ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "$n": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid",
          "$card": {
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "live": {
      ".read": "auth != null",
      "$c": {
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
      }
    },
    "sheets": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
      }
    },
    "bonus": {
      "$c": {
        ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "$n": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid",
          "$lesson": {
            "$mid": {
              ".validate": "newData.hasChildren(['tries']) && newData.child('tries').isNumber() && newData.child('tries').val() >= 1 && newData.child('tries').val() <= 999"
            }
          }
        }
      }
    },
    "xp": {
      "$c": {
        ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "$n": {
          ".read": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)",
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "log": {
            "$k": {
              ".validate": "newData.hasChildren(['xp']) && newData.child('xp').isNumber() && newData.child('xp').val() >= 0 && newData.child('xp').val() <= 300"
            }
          }
        }
      }
    },
    "records": {
      "$c": {
        ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "$n": {
          ".read": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)",
          "$lesson": {
            ".validate": "newData.hasChildren(['at'])"
          }
        }
      }
    },
    "slots": {
      ".read": "auth != null",
      "$c": {
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
      }
    },
    "sched": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
    },
    "classlog": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
    },
    "att": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
    },
    "funStats": {
      ".read": "auth != null",
      "$qi": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['n', 'm']) && newData.child('n').isNumber() && newData.child('n').val() === (data.exists() ? data.child('n').val() + 1 : 1) && newData.child('m').isNumber() && newData.child('m').val() >= 0 && newData.child('m').val() <= newData.child('n').val() * 0.5 + 0.01"
      }
    },
    "funUsed": {
      "$c": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$qi": {
          ".validate": "newData.val() === true"
        }
      }
    },
    "held": {
      ".read": "auth != null",
      "$c": {
        ".write": "auth != null",
        "$lesson": {
          ".validate": "newData.val() === true"
        }
      }
    },
    "survey": {
      ".read": "auth != null",
      "$c": {
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
        ".validate": "!newData.exists() || (newData.hasChildren(['open', 'no']) && newData.child('open').val() === true && newData.child('no').isNumber())"
      }
    },
    "surveyA": {
      "$c": {
        ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "$k": {
          ".write": "auth != null && ((!data.exists() && root.child('survey/'+$c+'/open').val() === true) || (!newData.exists() && root.child('admins/'+auth.uid).val() === true))",
          ".validate": "!newData.exists() || (newData.hasChildren(['no', 'r', 'pick', 'cmp']) && newData.child('no').isNumber() && newData.child('cmp').isNumber() && (!newData.child('say').exists() || (newData.child('say').isString() && newData.child('say').val().length <= 100)) && (!newData.child('want').exists() || (newData.child('want').isString() && newData.child('want').val().length <= 100)))"
        }
      }
    },
    "surveyDone": {
      "$c": {
        ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "$n": {
          ".read": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)",
          ".write": "auth != null && ((!data.exists() && newData.val() === true && root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid) || (!newData.exists() && root.child('admins/'+auth.uid).val() === true))"
        }
      }
    },
    "rift": {
      ".read": "auth != null",
      "$c": {
        "$lesson": {
          ".write": "auth != null && (root.child('admins/'+auth.uid).val() === true || (newData.child('code').isString() && root.child('rooms/'+newData.child('code').val()+'/hosts/'+auth.uid).exists()) || (newData.child('code').isString() && root.child('rooms/'+newData.child('code').val()+'/meta/teacher').val() === auth.uid))",
          "done": {
            "$n": {
              ".write": "auth != null && newData.val() === true && root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid"
            }
          }
        }
      }
    },
    "gem": {
      "$c": {
        ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
        "$n": {
          ".read": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)"
        }
      }
    },
    "combo": {
      ".read": "auth != null",
      "$c": {
        ".write": "auth != null && (root.child('admins/'+auth.uid).val() === true || (newData.child('code').isString() && root.child('rooms/'+newData.child('code').val()+'/hosts/'+auth.uid).exists()) || (newData.child('code').isString() && root.child('rooms/'+newData.child('code').val()+'/meta/teacher').val() === auth.uid))",
        ".validate": "newData.hasChildren(['best', 'at', 'code']) && newData.child('best').isNumber()"
      }
    },
    "punch": {
      ".read": "auth != null",
      "$lesson": {
        "$c": {
          ".write": "auth != null && (root.child('admins/'+auth.uid).val() === true || (newData.child('code').isString() && root.child('rooms/'+newData.child('code').val()+'/hosts/'+auth.uid).exists()) || (newData.child('code').isString() && root.child('rooms/'+newData.child('code').val()+'/meta/teacher').val() === auth.uid))",
          ".validate": "newData.hasChildren(['s', 'm', 'at', 'code']) && newData.child('s').isNumber() && newData.child('s').val() >= 0 && newData.child('s').val() <= 1000"
        }
      }
    },
    "gcfg": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "floorOpen": {
        "$floor": {
          ".validate": "newData.isBoolean() && $floor.matches(/^eval-[0-9]+$/)"
        }
      }
    },
    "tcfg": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "hallPw": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
      }
    },
    "fb": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$c": {
        "$n": {
          "$id": {
            ".write": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)",
            ".validate": "!newData.exists() || (newData.hasChildren(['k', 't', 'at']) && newData.child('t').isString() && newData.child('t').val().length <= 400 && newData.child('k').isString())"
          }
        }
      }
    },
    "act": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$c": {
        "$day": {
          "$n": {
            ".write": "auth != null && (root.child('accounts/'+$c+'/'+$n+'/uid').val() === auth.uid || root.child('admins/'+auth.uid).val() === true)"
          }
        }
      }
    }
  }
}
